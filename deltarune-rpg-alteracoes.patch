+/* Perícias na ficha: grupos recolhíveis para manter a leitura leve. */
+.proficiencies{margin-top:18px;padding:24px 26px}
+.proficiency-head{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
+.proficiency-head .box-title{margin:0}
+.proficiency-head p{margin:10px 0 0;color:#b9b7d3;font-size:12px;line-height:1.6}
+.proficiency-budget{display:flex;align-items:center;gap:14px;padding:10px 14px;border:1px solid rgba(156,221,255,.3);background:rgba(6,14,33,.6)}
+.proficiency-budget span{color:#a9bdd6;font-size:10px;letter-spacing:.08em;font-weight:700}
+.proficiency-budget strong{color:var(--cyan,#a9edff);font-size:17px;white-space:nowrap}
+.proficiency-warning{margin:14px 0 0;color:#ffbd9d;font-size:12px;line-height:1.5}
+.proficiency-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:18px;align-items:start}
