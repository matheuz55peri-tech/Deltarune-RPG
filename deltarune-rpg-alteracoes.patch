+@media(max-width:480px){.proficiencies{padding:20px 16px}.proficiency-head{gap:12px}.proficiency-groups{gap:7px}.proficiency-group-head{font-size:9px;padding:12px 8px}.proficiency-list{padding:5px 7px}.proficiency-row{font-size:11px}.proficiency-controls{gap:2px}.proficiency-controls button{width:24px}}
