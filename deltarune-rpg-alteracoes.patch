+.proficiency-list{border-top:1px solid rgba(190,193,239,.18);padding:5px 10px 8px}
+.proficiency-row{display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:38px;font-size:12px}
+.proficiency-name{min-width:0;overflow-wrap:anywhere}
+.proficiency-controls{display:flex;align-items:center;gap:4px;flex-shrink:0}
+.proficiency-controls button{width:26px;height:27px;padding:0;background:#211e39;border:1px solid #56506f;color:#fff;font-size:17px;cursor:pointer}
+.proficiency-controls button:hover:not(:disabled){background:#493b77}
+.proficiency-controls button:disabled{opacity:.35;cursor:not-allowed}
+.proficiency-value{min-width:22px;text-align:center;color:#d7f7ff;font-weight:800;font-size:12px}
