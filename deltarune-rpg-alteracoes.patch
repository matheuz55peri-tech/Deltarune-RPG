+.proficiency-group-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:13px 10px;cursor:pointer;list-style:none;font-size:10px;font-weight:800;letter-spacing:.05em}
+.proficiency-group-head::-webkit-details-marker{display:none}
+.proficiency-group-head:after{content:'+';color:#b7a7ff;font-size:18px;line-height:1}
+.proficiency-group[open] .proficiency-group-head:after{content:'−'}
+.proficiency-group-head:focus-visible,.proficiency-controls button:focus-visible{outline:2px solid #a9edff;outline-offset:2px}
+.proficiency-group-total{margin-left:auto;color:#aab5d2;font-size:9px;white-space:nowrap}
+.proficiency-group[data-group="strength"] .proficiency-group-head{color:#ff879e}
+.proficiency-group[data-group="defense"] .proficiency-group-head{color:#7ee6ff}
+.proficiency-group[data-group="intelligence"] .proficiency-group-head{color:#d6a0ff}
